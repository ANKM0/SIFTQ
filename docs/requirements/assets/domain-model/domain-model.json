  "api": {
    "tasks_list": { "kind": "api", "method": "GET", "path": "/api/tasks", "operation": "list", "entity": "tasks", "success": 200, "errors": [{ "status": 500 }] },
    "tasks_get": { "kind": "api", "method": "GET", "path": "/api/tasks/{id}", "operation": "get", "entity": "tasks", "success": 200, "errors": [{ "status": 404, "code": "NOT_FOUND" }, { "status": 500 }] },
    "tasks_create": { "kind": "api", "method": "POST", "path": "/api/tasks", "operation": "create", "entity": "tasks", "success": 201, "errors": [{ "status": 400, "code": "INVALID_TITLE" }, { "status": 500 }] },
    "tasks_patch": { "kind": "api", "method": "PATCH", "path": "/api/tasks/{id}", "operation": "patch", "entity": "tasks", "success": 200, "errors": [{ "status": 400, "code": "INVALID_TITLE" }, { "status": 400, "code": "INVALID_DESCRIPTION" }, { "status": 400, "code": "INVALID_STATUS" }, { "status": 400, "code": "INVALID_AREA" }, { "status": 400, "code": "INVALID_WORKING" }, { "status": 400, "code": "INVALID_ORDER" }, { "status": 404, "code": "NOT_FOUND" }, { "status": 409, "code": "CONFLICT" }] },
    "tasks_delete": { "kind": "api", "method": "DELETE", "path": "/api/tasks/{id}", "operation": "delete", "entity": "tasks", "success": 204, "errors": [{ "status": 400, "code": "INVALID_ORDER" }, { "status": 404, "code": "NOT_FOUND" }, { "status": 409, "code": "CONFLICT" }] },
    "tasks_bulk_status": { "kind": "api", "method": "PATCH", "path": "/api/tasks/bulk/status", "operation": "bulk-status", "entity": "tasks", "success": 200, "errors": [{ "status": 400, "code": "INVALID_BULK_INPUT" }, { "status": 400, "code": "INVALID_STATUS" }, { "status": 404, "code": "NOT_FOUND" }, { "status": 409, "code": "CONFLICT" }] },
    "tasks_bulk_delete": { "kind": "api", "method": "DELETE", "path": "/api/tasks/bulk", "operation": "bulk-delete", "entity": "tasks", "success": 204, "errors": [{ "status": 400, "code": "INVALID_BULK_INPUT" }, { "status": 404, "code": "NOT_FOUND" }, { "status": 409, "code": "CONFLICT" }] },
    "tasks_reorder": { "kind": "api", "method": "POST", "path": "/api/tasks/reorder", "operation": "reorder", "entity": "tasks", "success": 200, "errors": [{ "status": 400, "code": "INVALID_ORDER" }, { "status": 409, "code": "CONFLICT" }] },
    "ideas_list": { "kind": "api", "method": "GET", "path": "/api/ideas", "operation": "list", "entity": "ideas", "success": 200, "errors": [{ "status": 500 }] },
    "ideas_create": { "kind": "api", "method": "POST", "path": "/api/ideas", "operation": "create", "entity": "ideas", "success": 201, "errors": [{ "status": 400, "code": "INVALID_INPUT" }, { "status": 400, "code": "INVALID_TITLE" }, { "status": 400, "code": "INVALID_DESCRIPTION" }] },
    "ideas_patch": { "kind": "api", "method": "PATCH", "path": "/api/ideas/{id}", "operation": "patch", "entity": "ideas", "success": 200, "errors": [{ "status": 400, "code": "INVALID_INPUT" }, { "status": 400, "code": "INVALID_ORDER" }, { "status": 400, "code": "INVALID_TITLE" }, { "status": 400, "code": "INVALID_DESCRIPTION" }, { "status": 404, "code": "NOT_FOUND" }, { "status": 409, "code": "CONFLICT" }] },
    "ideas_delete": { "kind": "api", "method": "DELETE", "path": "/api/ideas/{id}", "operation": "delete", "entity": "ideas", "success": 204, "errors": [{ "status": 404, "code": "NOT_FOUND" }, { "status": 409, "code": "CONFLICT" }] },
