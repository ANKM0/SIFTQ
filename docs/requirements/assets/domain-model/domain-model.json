{
  "domains": {
    "string": { "kind": "primitive" },
    "boolean": { "kind": "primitive" },
    "number": { "kind": "primitive" },
    "datetime": { "kind": "primitive" },
    "status": { "kind": "state", "logical": "string", "values": ["do", "done", "skip"] },
    "area": { "kind": "quadrant", "logical": "number", "values": [1, 2, 3, 4] }
  },
  "entities": {
    "tasks": {
      "description": "タスク。実行対象・完了・見送りを status で表す。",
      "attributes": {
        "id": { "domain": "string", "pk": true },
        "owner_id": { "domain": "string" },
        "title": { "domain": "string", "note": "Unicodeコードポイント数で1以上256以下", "rules": ["INV-TM-005"] },
        "description": { "domain": "string", "note": "Unicodeコードポイント数で0以上16,384以下", "rules": ["INV-TM-006"] },
        "status": { "domain": "status", "rules": ["INV-TM-001"] },
        "area": { "domain": "area", "note": "1 / 2 / 3 / 4", "rules": ["INV-TM-002", "INV-TM-007"] },
        "working": { "domain": "boolean", "rules": ["INV-TM-003"] },
        "order": { "domain": "number", "note": "pinned / unpinned各グループ内の表示順" },
        "version": { "domain": "number" },
        "created_at": { "domain": "datetime" },
        "updated_at": { "domain": "datetime" }
      },
      "rules": ["INV-TM-004"]
    },
    "ideas": {
      "description": "タスクとは独立したアイデア。カード一覧で表示する。",
      "attributes": {
        "title": { "domain": "string", "note": "Title 値オブジェクト。Unicodeコードポイント数で1以上256以下", "rules": ["INV-TM-005"] },
        "description": { "domain": "string", "note": "Description 値オブジェクト。Unicodeコードポイント数で0以上16,384以下", "rules": ["INV-TM-006"] },
        "order": { "domain": "number" },
        "pinned": { "domain": "boolean", "note": "固定表示するかどうか" }
      }
    }
  },
  "relations": [],
  "flows": {
    "task_management": {
      "name": "タスクを管理する",
      "actor": "user",
      "steps": [
        { "name": "タスクを登録する", "entity": "tasks", "changes": { "status": "do" } },
        { "name": "重要度・緊急度で area を決める", "entity": "tasks", "changes": { "area": [1, 2, 3, 4] } },
        { "name": "実行中にする", "entity": "tasks", "changes": { "working": true } },
        { "name": "完了または見送りにする", "entity": "tasks", "changes": { "status": ["done", "skip"] } },
        { "name": "一覧で振り返る", "entity": "tasks" }
      ]
    },
    "idea_management": {
      "name": "アイデアを管理する",
      "actor": "user",
      "steps": [
        { "name": "Ideaを表示する", "entity": "ideas", "when": "pinned を先にして各グループ内を order の昇順でカード表示" },
        { "name": "Ideaを作成する", "entity": "ideas", "changes": { "title": "入力値", "description": "入力値", "order": "末尾", "pinned": false } },
        { "name": "Ideaを編集する", "entity": "ideas", "changes": { "title": "入力値", "description": "入力値" } },
        { "name": "Ideaのピン留め状態を切り替える", "entity": "ideas", "changes": { "pinned": [true, false] } },
        { "name": "Ideaを並べ替える", "entity": "ideas", "changes": { "order": "新しい表示順" } },
        { "name": "Ideaを削除する", "entity": "ideas", "when": "確認後に一覧から除外" }
      ]
    }
  },
  "screens": {
    "P00": { "name": "Login", "entities": ["tasks"], "actions": ["login"] },
    "P01": { "name": "Matrix", "entities": ["tasks"], "actions": ["dnd", "context-menu"] },
    "P02": { "name": "Task list", "entities": ["tasks"], "actions": ["filter", "bulk", "delete"] },
    "P03": { "name": "Task detail", "entities": ["tasks"], "actions": ["edit", "save"] },
    "P04": { "name": "New task", "entities": ["tasks"], "actions": ["create", "cancel"] },
    "P05": { "name": "Status popover", "entities": ["tasks"], "actions": ["select-status"] },
    "P06": { "name": "Area popover", "entities": ["tasks"], "actions": ["select-area"] },
    "P07": { "name": "Delete confirmation dialog", "entities": ["tasks"], "actions": ["confirm-delete", "cancel"] },
    "P08": { "name": "Idea list", "entities": ["ideas"], "actions": ["create", "edit", "delete", "pin", "reorder"] }
  },
  "navigation": [
    { "from": "P00", "on": "ログイン成功", "to": "P08" },
    { "from": "P01", "on": "Tasks 押下", "to": "P02" },
    { "from": "P01", "on": "Ideas 押下", "to": "P08" },
    { "from": "P02", "on": "Matrix 押下", "to": "P01" },
    { "from": "P02", "on": "Ideas 押下", "to": "P08" },
    { "from": "P08", "on": "Tasks 押下", "to": "P02" },
    { "from": "P08", "on": "Matrix 押下", "to": "P01" },
    { "from": "P01", "on": "New task / area 空白押下", "to": "P04" },
    { "from": "P02", "on": "New task 押下", "to": "P04" },
    { "from": "P04", "on": "Create 押下", "to": "P03" },
    { "from": "P04", "on": "Cancel 押下", "to": "P01" },
    { "from": "P04", "on": "Cancel 押下", "to": "P02" },
    { "from": "P01", "on": "task card 押下", "to": "P03" },
    { "from": "P02", "on": "task row 押下", "to": "P03" },
    { "from": "P03", "on": "Tasks / Cancel 押下", "to": "P02" },
    { "from": "P03", "on": "Save 押下", "to": "P03" },
    { "from": "P04", "on": "Status 押下", "to": "P05" },
    { "from": "P05", "on": "status 選択 / 外側押下", "to": "P04" },
    { "from": "P04", "on": "Area 押下", "to": "P06" },
    { "from": "P06", "on": "area 選択 / 外側押下", "to": "P04" },
    { "from": "P03", "on": "Status 押下", "to": "P05" },
    { "from": "P05", "on": "status 選択 / 外側押下", "to": "P03" },
    { "from": "P03", "on": "Area 押下", "to": "P06" },
    { "from": "P06", "on": "area 選択 / 外側押下", "to": "P03" },
    { "from": "P05", "on": "Area 押下", "to": "P06" },
    { "from": "P06", "on": "Status 押下", "to": "P05" },
    { "from": "P01", "on": "ドラッグ&ドロップ", "to": "P01" },
    { "from": "P01", "on": "delete 選択", "to": "P07" },
    { "from": "P07", "on": "キャンセル / 削除", "to": "P01" }
  ]
}
