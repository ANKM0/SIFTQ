# ドメインモデル図。正本の補助。正本は domain.md と domain-model.json。
direction: right

task: "Task（集約ルート）" {
  shape: class
  invariant_002: "INV-TM-002: status変更後もareaを保持"
  invariant_003: "INV-TM-003: workingはstatusと独立"
  invariant_004: "INV-TM-004: orderはowner_id + area内で連番"
  +title: Title
  +description: Description
  +status: Status
  +area: Area
  +working: boolean
  +order: number
}

title: "Title（値オブジェクト）" {
  shape: class
  invariant: "INV-TM-005: title の長さはUnicodeコードポイント数で1以上256以下とする"
  +value: string
  min_length: "1"
  max_length: "256"
}

description: "Description（値オブジェクト）" {
  shape: class
  invariant: "description の長さはUnicodeコードポイント数で0以上16,384以下とする"
  +value: string
  min_length: "0"
  max_length: "16,384"
}

status: "Status（値オブジェクト）" {
  shape: class
  invariant: "INV-TM-001: status は do / done / skip のいずれか"
  +value: do | done | skip
}

area: "Area（値オブジェクト）" {
  shape: class
  invariant: "area は 1 / 2 / 3 / 4 のいずれか"
  +value: 1 | 2 | 3 | 4
}

task -> status: status
task -> area: area
task -> title: title
task -> description: description
