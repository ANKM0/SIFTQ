{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "domain-model",
  "description": "概念図・ER図・業務フロー・UI の単一ソース。形と遷移のみを持ち、振る舞いは持たない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["domains", "entities"],
  "properties": {
    "domains": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "$ref": "#/definitions/domain" }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "$ref": "#/definitions/entity" }
      },
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/definitions/relation" }
    },
    "flows": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "$ref": "#/definitions/flow" }
      },
      "additionalProperties": false
    },
    "screens": {
      "type": "object",
      "patternProperties": {
        "^P[0-9]{2}$": { "$ref": "#/definitions/screen" }
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "array",
      "items": { "$ref": "#/definitions/navigationItem" }
    }
  },
  "definitions": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "logical": { "enum": ["string", "boolean", "number", "datetime"] },
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": ["string", "number"] } }
      },
      "if": { "properties": { "kind": { "const": "primitive" } }, "required": ["kind"] },
      "then": { "not": { "anyOf": [{ "required": ["values"] }, { "required": ["logical"] }] } },
      "else": { "required": ["values", "logical"] }
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^INV-TM-[0-9]{3}$" }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "pk": { "type": "boolean" },
        "note": { "type": "string" },
        "rules": { "$ref": "#/definitions/rules" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "from", "to"],
      "properties": {
        "on": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "from": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "minItems": 1, "items": { "type": "string" } }
          ]
        },
        "to": { "type": "string" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attributes"],
      "properties": {
        "description": { "type": "string" },
        "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "attributes": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": { "$ref": "#/definitions/attribute" }
          },
          "additionalProperties": false
        },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/transition" }
        },
        "rules": { "$ref": "#/definitions/rules" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "to": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": { "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"] },
        "on": { "type": "string" }
      }
    },
    "changeValue": {
      "anyOf": [
        { "type": ["string", "number", "boolean"] },
        { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean"] } }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "entity": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "changes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/definitions/changeValue" } },
        "when": { "type": "string", "minLength": 1 }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "steps"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "actor": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "entities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "entities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "on", "to"],
      "properties": {
        "from": { "type": "string", "pattern": "^P[0-9]{2}$" },
        "on": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "pattern": "^P[0-9]{2}$" }
      }
    }
  }
}
