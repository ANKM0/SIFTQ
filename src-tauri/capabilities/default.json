{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main window to use the Matrix task storage commands during local development and bundled app execution.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:5173"]
  },
  "permissions": [
    "core:default",
    "allow-get-storage-health",
    "allow-create-task",
    "allow-list-tasks",
    "allow-move-task",
    "allow-reorder-task",
    "allow-update-task-title"
  ]
}
