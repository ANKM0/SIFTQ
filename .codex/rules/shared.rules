prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:cleanup"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:worker"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:watch"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:sync"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:self-improvement"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "self-improvement:scan"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:worktree"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:commit"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:push"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:pr"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:merge"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:release-decision"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:route:dry-run"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:report"], decision="allow")

# Forbidden: secrets and local credentials
prefix_rule(pattern=["cat", ".env"], decision="forbidden")
prefix_rule(pattern=["cat", ".env.local"], decision="forbidden")
prefix_rule(pattern=["cat", ".env.production"], decision="forbidden")
prefix_rule(pattern=["cat", "auth.json"], decision="forbidden")
prefix_rule(pattern=["cat", "/home/develop/.config/gh/hosts.yml"], decision="forbidden")
prefix_rule(pattern=["cat", "/home/develop/.ssh"], decision="forbidden")

# Forbidden: destructive file operations
prefix_rule(pattern=["rm", "-rf", "/"], decision="forbidden")
prefix_rule(pattern=["rm", "-rf", "."], decision="forbidden")
prefix_rule(pattern=["rm", "-rf", "*"], decision="forbidden")
prefix_rule(pattern=["find", ".", "-delete"], decision="forbidden")

# Forbidden: destructive Git operations
prefix_rule(pattern=["git", "push", "--force"], decision="forbidden")
prefix_rule(pattern=["git", "push", "--force-with-lease"], decision="forbidden")
prefix_rule(pattern=["git", "switch", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "-f"], decision="forbidden")
prefix_rule(pattern=["git", "checkout", "--", "."], decision="forbidden")
prefix_rule(pattern=["git", "restore", "."], decision="forbidden")
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden")
prefix_rule(pattern=["git", "clean", "-fd"], decision="forbidden")
prefix_rule(pattern=["git", "clean", "-fdx"], decision="forbidden")

# Forbidden: broad privilege operations
prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["chmod", "-R"], decision="forbidden")
prefix_rule(pattern=["chown", "-R"], decision="forbidden")
