# Shared command rules
#
# Install path:
#   .codex/rules/shared.rules
#
# Policy:
# - allow: safe read, investigation, validation, GitHub issue/PR, and normal
#   branch publishing commands used by project workflows.
# - forbidden: secrets, destructive operations, production operations, and broad
#   privilege changes.
# - undefined commands require human approval or case-by-case handling.

# Allow: read-only shell/file metadata inspection
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["ps"], decision="allow")
prefix_rule(pattern=["test"], decision="allow")
prefix_rule(pattern=["true"], decision="allow")
prefix_rule(pattern=["sleep"], decision="allow")
prefix_rule(pattern=["mkdir", "-p"], decision="allow")

# Allow: read-only Git inspection
prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "branch", "--show-current"], decision="allow")
prefix_rule(pattern=["git", "remote"], decision="allow")

# Allow: normal project Git branch and publish workflow
prefix_rule(pattern=["git", "switch", "main"], decision="allow")
prefix_rule(pattern=["git", "switch", "-c"], decision="allow")
prefix_rule(pattern=["git", "checkout", "-b"], decision="allow")
prefix_rule(pattern=["git", "pull", "--ff-only"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "push", "-u"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["git", "worktree"], decision="allow")
prefix_rule(pattern=["git", "fetch"], decision="allow")
prefix_rule(pattern=["git", "merge"], decision="allow")
prefix_rule(pattern=["git", "stash"], decision="allow")

# Allow: GitHub inspection and issue/PR operations
prefix_rule(pattern=["gh", "issue", "list"], decision="allow")
prefix_rule(pattern=["gh", "issue", "view"], decision="allow")
prefix_rule(pattern=["gh", "issue", "create"], decision="allow")
prefix_rule(pattern=["gh", "issue", "edit"], decision="allow")
prefix_rule(pattern=["gh", "issue", "comment"], decision="allow")
prefix_rule(pattern=["gh", "issue", "close"], decision="allow")
prefix_rule(pattern=["gh", "label", "list"], decision="allow")
prefix_rule(pattern=["gh", "label", "create"], decision="allow")
prefix_rule(pattern=["gh", "label", "edit"], decision="allow")
prefix_rule(pattern=["gh", "label", "delete"], decision="allow")
prefix_rule(pattern=["gh", "pr", "list"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["gh", "pr", "diff"], decision="allow")
prefix_rule(pattern=["gh", "pr", "checks"], decision="allow")
prefix_rule(pattern=["gh", "pr", "create"], decision="allow")
prefix_rule(pattern=["gh", "pr", "edit"], decision="allow")
prefix_rule(pattern=["gh", "pr", "ready"], decision="allow")
prefix_rule(pattern=["gh", "pr", "merge"], decision="allow")
prefix_rule(pattern=["gh", "run", "list"], decision="allow")
prefix_rule(pattern=["gh", "run", "view"], decision="allow")
prefix_rule(pattern=["gh", "run", "rerun"], decision="allow")
prefix_rule(pattern=["gh", "repo", "view"], decision="allow")
prefix_rule(pattern=["gh", "auth", "status"], decision="allow")

# Allow: local project validation
prefix_rule(pattern=["aqua", "install"], decision="allow")
prefix_rule(pattern=["uv", "sync"], decision="allow")
prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["pnpm", "test"], decision="allow")
prefix_rule(pattern=["pnpm", "lint"], decision="allow")
prefix_rule(pattern=["pnpm", "build"], decision="allow")
prefix_rule(pattern=["python3", "/home/develop/.codex/skills/.system/skill-creator/scripts/quick_validate.py"], decision="allow")

# Allow: Taskfile command entrypoints
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "--list"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "default"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "pytest"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "codex:codex"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "codex:deepseek"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "codex:luna"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "codex:muse-spark:free"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "codex:profiles:init"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "codex:profiles:check"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:codex"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:aqua"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:bun"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:ouch"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:unzip"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:vite-plus"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:python"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:frontend"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "setup:frontend:ci"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "deploy"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "deploy:secrets"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "release:plan"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "release:create"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "deploy:plan"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "deploy:release"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "graphify:update"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "repo:pull-main"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:fast"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:fast:checks"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:extended"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:extended:checks"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:commit-messages"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:markdown"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:lint:task-refs"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:lint:codex-task-perms"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:typecheck"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:lint"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:lint:python"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:test"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:test:unit"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:test:e2e"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:test:e2e:setup"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:build"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:duplicate"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:dead-code"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:security"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:performance"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:requirements"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "docs:screen-flow:fsm:d2:svg"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:architecture"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:architecture:metrics"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:glossary"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:docs"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:domain"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "docs:domain:svg"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "docs:domain:viewer"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:wireframes"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:llm-eval"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "eval:review"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "ci:rust"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "dev"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "tauri:dev"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:create"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:run"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:switch:show"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:switch:main"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:switch:deepseek"], decision="allow")
prefix_rule(pattern=["task", "-t", ".config/Taskfile.yml", "taqt:switch:qwen"], decision="allow")
