{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail@4.9.0"
  ],
  "permission": {
    "bash": {
      "rm -rf /*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git push --force*": "deny"
    },
    "skill": {
      "*": "allow"
    }
  }
}
