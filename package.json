{
  "name": "app",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "cf dev",
    "preview:mock": "PREVIEW_MODE=true AUTH_PASSWORD=preview SESSION_SECRET=preview-session-secret cf dev",
    "build": "tsc -p tsconfig.json && cf deploy --dry-run",
    "deploy": "cf deploy",
    "typegen": "cf workers types",
    "lint": "vp lint .",
    "test": "vp test run --passWithNoTests",
    "test:e2e": "playwright test -c .config/playwright.config.ts --pass-with-no-tests",
    "typecheck": "tsc -p tsconfig.json",
    "docs:flow:svg": "mmdc -i docs/contributing/assets/development-flow.mmd -o docs/contributing/assets/development-flow.svg",
    "docs:app-architecture:svg": "mmdc -p docs/contributing/assets/app-architecture-puppeteer.json -c docs/contributing/assets/app-architecture-mermaid.json -i docs/contributing/assets/app-architecture.mmd -o docs/contributing/assets/app-architecture.svg",
    "docs:domain:svg": "bun tools/domain-blueprint/src/cli.ts build --config .config/domain-blueprint.json"
  },
  "dependencies": {
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "cf": "1.0.0-beta.12",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "^26.2.0",
    "@playwright/test": "^1.61.1",
    "ajv": "^8.17.1",
    "dependency-cruiser": "^18.2.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "md2idx": "^0.3.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "esbuild",
    "puppeteer",
    "workerd"
  ]
}
