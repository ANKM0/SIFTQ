{
  "name": "siftq",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "wrangler dev",
    "preview:mock": "wrangler dev --var PREVIEW_MODE:true --var AUTH_PASSWORD:preview --var SESSION_SECRET:preview-session-secret",
    "build": "tsc -p tsconfig.json && wrangler deploy --dry-run",
    "lint": "vp lint .",
    "test": "vp test run --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typecheck": "tsc -p tsconfig.json",
    "docs:flow:svg": "mmdc -i docs/contributing/assets/development-flow.mmd -o docs/contributing/assets/development-flow.svg",
    "docs:screen-flow:svg": "mmdc -c docs/requirements/assets/screen-flow-mermaid.json -i docs/requirements/assets/screen-flow.mmd -o docs/requirements/assets/screen-flow.svg",
    "docs:app-architecture:svg": "mmdc -p docs/contributing/assets/app-architecture-puppeteer.json -c docs/contributing/assets/app-architecture-mermaid.json -i docs/contributing/assets/app-architecture.mmd -o docs/contributing/assets/app-architecture.svg"
  },
  "dependencies": {
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "^26.2.0",
    "@playwright/test": "^1.61.1",
    "dependency-cruiser": "^18.2.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "md2idx": "^0.3.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "esbuild",
    "puppeteer",
    "workerd"
  ]
}
